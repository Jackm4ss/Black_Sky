APP_NAME="Black Sky"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000,localhost:5173,127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=black_sky
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

SCOUT_DRIVER=collection
SCOUT_QUEUE=false
SCOUT_AFTER_COMMIT=true
PUBLIC_SEARCH_RESULT_LIMIT=1000

# Production PRD target:
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# BROADCAST_CONNECTION=reverb
# SCOUT_DRIVER=meilisearch
# SCOUT_QUEUE=true
# MAIL_MAILER=smtp

BLACK_SKY_ENFORCE_PRODUCTION_SERVICES=true
BLACK_SKY_PRODUCTION_SESSION_DRIVER=redis
BLACK_SKY_PRODUCTION_QUEUE_CONNECTION=redis
BLACK_SKY_PRODUCTION_CACHE_STORE=redis
BLACK_SKY_PRODUCTION_SEARCH_DRIVER=meilisearch
BLACK_SKY_PRODUCTION_REQUIRE_MEILISEARCH_KEY=true
BLACK_SKY_PRODUCTION_REQUIRE_MAIL_FROM_ADDRESS=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@blacksky.test"
MAIL_FROM_NAME="${APP_NAME}"

BLACK_SKY_ADMIN_NAME="Black Sky Admin"
BLACK_SKY_ADMIN_EMAIL=admin@blacksky.test
BLACK_SKY_ADMIN_PASSWORD=password

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_AUTH_DRIVER=sanctum
VITE_API_BASE_URL=
